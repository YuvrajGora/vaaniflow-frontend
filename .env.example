# VaaniFlow AI Frontend Environment Configuration
# Point this to your teammate's FastAPI backend when ready (e.g., http://localhost:8000/api)
VITE_API_BASE_URL=http://localhost:8000/api

# Set to 'true' to use the frontend mock adapter during independent development
# Set to 'false' once the FastAPI backend is running and connected
VITE_USE_MOCK=true
